# PaperEase - Variables de Entorno
# Copia este archivo a .env y llena los valores para tu entorno

# ─── Entorno ───
NODE_ENV=development

# ─── Base de Datos (opciones alternativas) ───
# Opción A: URL completa (Railway, Heroku, etc.)
# DATABASE_URL=mysql://user:password@host:3306/paperease

# Opción B: Variables individuales
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=paperease

# ─── Servidor ───
PORT=3000
BASE_URL=http://localhost:3000

# ─── Frontend (para CORS) ───
# FRONTEND_URL=https://tu-dominio.com
